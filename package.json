{
  "name": "dsh-todos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness plugin: a todo tracker in the left sidebar panel, with items linked to the DSH session that owns the work and one-click navigation back to it.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "todo",
    "task-manager",
    "pomodoro",
    "eisenhower-matrix"
  ],
  "license": "MIT",
  "author": "kaelinda",
  "homepage": "https://github.com/kaelinda/dsh-today-todo#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kaelinda/dsh-today-todo.git"
  },
  "bugs": {
    "url": "https://github.com/kaelinda/dsh-today-todo/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
